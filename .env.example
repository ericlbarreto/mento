# Copy to .env (git-ignored). Names are planned in docs/20-demo-runbook.md §2.
# Never commit real keys.

# --- API service (apps/api) ---
API_PORT=4000
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info
DEMO_MODE=live            # live | fixture (fixture replays recorded turns, no providers needed)
MONGODB_URI=mongodb://localhost:27017/mento

# --- Web app (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Providers (chosen after the day-0 bake-offs; see docs/11 and workstreams/) ---
LLM_API_KEY=
LLM_MODEL_TUTOR=
LLM_MODEL_ANALYSIS=
IMAGE_API_KEY=
IMAGE_MODEL=
STT_API_KEY=              # Deepgram: used only to mint short-lived browser tokens
TTS_API_KEY=              # ElevenLabs by default
TTS_VOICE=
