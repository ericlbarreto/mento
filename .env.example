# Copy to .env (git-ignored). Names are planned in docs/20-demo-runbook.md §2.
# Never commit real keys.

# --- API service (apps/api) ---
API_PORT=4000
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info
DEMO_MODE=live            # live | fixture (fixture replays recorded turns, no providers needed)
MONGODB_URI=mongodb://localhost:27017/mento

# --- Web app (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Providers (names read by apps/api/src/config.ts; see docs/superpowers/specs/2026-10-30-whiteboard-backend-design.md) ---
ANTHROPIC_API_KEY=        # tutor and judge
TUTOR_MODEL=claude-haiku-5-5
TUTOR_THINKING=disabled   # adaptive | between_tools | disabled | default (Sonnet 5.5 does not accept disabled: use between_tools)
TUTOR_EFFORT=default      # low | medium | high | default
JUDGE_MODEL=claude-haiku-5-5
DEEPGRAM_API_KEY=         # STT: used only to mint short-lived browser tokens
ELEVENLABS_API_KEY=       # TTS (needs text_to_speech permission)
ELEVENLABS_VOICE_ID=      # the chosen pt-BR voice
ELEVENLABS_MODEL=eleven_flash_v2_5
TTS_MODE=ws               # ws (streaming, lowest latency) | http (fallback)
GEMINI_API_KEY=           # images (billing must be enabled on the Google project)
IMAGE_MODEL=gemini-3.1-flash-lite-image
VOYAGE_API_KEY=           # embeddings for the material search (free allowance)
DATA_DIR=                 # empty = <repo>/data (TTS and image caches)
