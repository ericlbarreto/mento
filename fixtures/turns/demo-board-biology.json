    }
   }
  },
  {
   "at_ms": 360,
   "message": {
    "type": "action",
    "order": 3,
    "action": {
     "id": "b3",
     "name": "speak",
     "args": {
      "text": "Cada glândula fica num lugar do corpo, mas o hormônio viaja pelo sangue e só age onde tem receptor.",
      "purpose": "explain",
      "sources": [
       {
        "material_id": "6ae58c4dc54e8af46024b34e",
        "page": 9,
        "quote": "cada hormônio só age nas células que têm receptores capazes de reconhecê-lo"
       }
      ]
     }
    }
   }
  },
